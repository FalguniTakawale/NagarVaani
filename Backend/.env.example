# "development" keeps CORS open and allows the default JWT secret.
# Anything else (e.g. "production") locks CORS to FRONTEND_URL and refuses to
# start with the default JWT_SECRET.
ENVIRONMENT=development
FRONTEND_URL=https://your-app.onrender.com

ANTHROPIC_API_KEY=
# ai_engine.py uses Gemini by default (free tier, no card needed) — get a key
# at aistudio.google.com/apikey. Set ANTHROPIC_API_KEY above and flip
# _PROVIDER in ai_engine.py back to "anthropic" if you'd rather use Claude.
GEMINI_API_KEY=
JWT_SECRET=change-me-to-a-random-string

# Telegram bot — token from @BotFather. The webhook secret is any random string
# you choose; pass the same value as secret_token when calling setWebhook, and
# the webhook rejects any request that doesn't carry it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Whisper speech-to-text for voice notes (web mic + Telegram).
# stt.py uses Hugging Face's free Inference API by default (no card needed,
# but has cold-start delays) — get a token at huggingface.co/settings/tokens
# (read access is enough). Set GROQ_API_KEY or OPENAI_API_KEY and flip
# _PROVIDER in stt.py for a faster, more demo-reliable alternative.
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Preferred: Brevo over HTTPS (works on Render free, which blocks SMTP ports).
# API key: Brevo → SMTP & API → API Keys (starts with xkeysib-). Sender must be
# a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NagarVaani

# Fallback: Signup OTP + welcome email over Gmail SMTP. Use a Google "App password"
# (Google Account → Security → 2-Step Verification → App passwords), not your
# real password. Leave blank locally: the OTP is printed to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NagarVaani <you@gmail.com>

# Cloudinary — complaint photo/360° image uploads. Free tier: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "Continue with Google" sign-in. Create one at
# console.cloud.google.com/apis/credentials → Create credentials → OAuth
# client ID → Application type "Web application" → add your app's origin
# (e.g. http://127.0.0.1:8000 for local, your Render URL for prod) under
# "Authorized JavaScript origins". This id is public by design — it's sent
# to the browser — unlike every other key in this file. Leave blank to hide
# the Google button entirely; password sign-in always works regardless.
GOOGLE_CLIENT_ID=

# Local dev Postgres (brew services start postgresql@16 ; createdb nagarvaani):
DATABASE_URL=postgresql+asyncpg://localhost/nagarvaani

# Render deploy: paste the "Internal Database URL" from your Render Postgres
# instance here (postgresql://... or postgres://... — database.py rewrites
# either to the asyncpg driver automatically).

# Fallback for zero-setup local testing, no Postgres required:
# DATABASE_URL=sqlite+aiosqlite:///./nagarvaani.db
